# Store every value below only in the deployment secret manager (Vercel env vars), never in git.

# Reporting gateway (server-only; never shown to ChatGPT users).
AGENT_REPORTING_KEY=
AGENT_REPORTING_ENDPOINT=https://aaqquwhdglueqlnbifvn.supabase.co/functions/v1/agent-reporting

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client, type "Web application").
# Authorized redirect URI: <PUBLIC_BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public HTTPS origin of this server. On Vercel it defaults to the production domain.
PUBLIC_BASE_URL=

# Who may use the connector. Workspace domains (comma separated) and/or individual emails.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# OAuth state shared across serverless instances (Upstash Redis from the Vercel Marketplace sets REDIS_URL).
REDIS_URL=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=
# openssl rand -hex 32
JWT_SIGNING_KEY=

# Local testing only: MCP_ALLOW_UNAUTHENTICATED=1 skips Google sign-in (refused on Vercel).
# PORT=8000
# REPORTING_KNOWLEDGE_ROOT=/app
